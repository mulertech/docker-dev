{
  "name": "mulertech/docker-dev",
  "description": "The MulerTech Docker-dev package",
  "type": "library",
  "keywords": [
    "php",
    "docker",
    "development",
    "symfony"
  ],
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Sébastien Muler",
      "email": "sebastien.muler@mulertech.net"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-posix": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.6",
    "phpstan/phpstan": "^2.1",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "MulerTech\\DockerDev\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MulerTech\\DockerDev\\Tests\\": "./tests"
    }
  },
  "bin": [
    "mtdocker"
  ],
  "prefer-install": {
    "*": "source"
  },
  "config": {
    "sort-packages": true
  }
}
