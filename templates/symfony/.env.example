# =================================
# USER CONFIGURATION
# =================================
# Your local user ID (use: id -u)
USER_ID=1000
# Your local group ID (use: id -g)
GROUP_ID=1000

# =================================
# DOCKER OPTIMIZATION
# =================================
# Enable Docker BuildKit for faster builds (recommended)
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
# PHP Image (auto-detected from composer.json by mtdocker)
PHP_IMAGE=php:apache

# =================================
# CONTAINERS CONFIGURATION
# =================================
# Container names (useful for PhpStorm and identification)
CONTAINER_NAME_APACHE=apache-php
CONTAINER_NAME_POSTGRES=postgres-db
CONTAINER_NAME_ADMINER=symfony-adminer
CONTAINER_NAME_REDIS=symfony-redis
CONTAINER_NAME_MAILPIT=symfony-mailpit

# =================================
# PORTS CONFIGURATION
# =================================
# Port to access Apache web server (ex: http://localhost:8080)
APACHE_PORT=8080
# Port to access PostgreSQL directly (ex: localhost:5433)
POSTGRES_PORT=5433
# Port to access Adminer (ex: http://localhost:8081)
ADMINER_PORT=8081
# Port for Redis
REDIS_PORT=6380
# Port for MailPit web interface (ex: http://localhost:8025)
MAILPIT_PORT=8025
# SMTP port for MailPit
MAILPIT_SMTP_PORT=1026

# =================================
# DATABASE CONFIGURATION
# =================================
# Main database name
DB_NAME=db
# PostgreSQL user
DB_USER=user
# PostgreSQL user password
DB_PASSWORD=password
# Server version (used for mtdocker to detect the right image tag)
POSTGRES_VERSION=18